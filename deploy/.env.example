# Copy to ".env" (same folder as docker-compose.yml) and fill in real values.
# NEVER commit the real .env to git.

# Your DuckDNS hostname (must already point to this VM's public IP)
DOMAIN=yourname.duckdns.org

# Strong random Postgres password
POSTGRES_PASSWORD=change-this-to-a-long-random-string

# JWT signing secret — must match the var name auth_service.py expects.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string

# SMTP for login links / password resets / magic links.
# Brevo free tier (300 emails/day, real delivery):
#   host smtp-relay.brevo.com, port 587
# Mailtrap sandbox (links land in your Mailtrap inbox, not delivered to real users):
#   host sandbox.smtp.mailtrap.io, port 2525
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-login
SMTP_PASSWORD=your-smtp-password-or-key
MAIL_FROM=noreply@yourdomain.example
